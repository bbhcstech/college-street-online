APP_NAME="College Street Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------
# DATABASE (MySQL / MariaDB, InnoDB — see SRS Section 7)
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=college_street_online
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------
# MAIL (order confirmations, publisher/admin notifications)
# ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@collegestreetonline.com"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDINARY_URL=
CLOUDINARY_FOLDER=college-street-online/books

# ---------------------------------------------------------------
# PAYMENTS — currently manual-only (UTR upload), per FR-7.
# Fill these in once a gateway is integrated (SRS Section 10.2).
# ---------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=manual
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# ---------------------------------------------------------------
# FILESYSTEM / UPLOADS (book covers, payment proofs)
# ---------------------------------------------------------------
FILESYSTEM_DISK=public
